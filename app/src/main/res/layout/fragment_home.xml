<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E6"
    android:fontFamily="@font/playfair_display"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/home_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/chicago_background"
        android:scaleType="centerCrop"
        android:alpha="0.75"
        android:contentDescription="@string/chicago_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/halfway_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/halfway_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.50" />
    <androidx.cardview.widget.CardView
        app:cardCornerRadius="35dp"
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:cardBackgroundColor="@android:color/white"
        tools:ignore="MissingConstraints"
        app:cardElevation="4dp"

        android:layout_marginRight="8dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintTop_toBottomOf="@id/halfway_guideline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_sip_relax_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:gravity="center"
            android:text="Sip. Relax. Repeat"
            android:textSize="32dp"
            android:padding="5dp"
            android:textStyle="bold" />



        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="80dp"
            android:columnCount="2"
            android:rowCount="2"
            android:padding="2dp">



            <ImageView
                android:id="@+id/img_cinnamon_latte"
                android:layout_width="200dp"
                android:layout_height="100dp"
                android:layout_row="0"
                android:layout_column="0"
                android:scaleType="centerCrop"
                android:contentDescription="@string/brown_sugar_cold_brew"
                android:src="@drawable/brown_sugar_brew" />

            <ImageView
                android:id="@+id/img_frappuccino"
                android:layout_width="200dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/caramel_frappuccino"
                android:src="@drawable/caramel_frappuccino" />

            <ImageView
                android:id="@+id/img_mocha_chocolate"
                android:layout_height="100dp"
                android:layout_width="200dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/chocolate_truffle_mocha"
                android:src="@drawable/chocolate_truffle_mocha" />

            <ImageView
                android:id="@+id/img_vanilla"
                android:layout_width="200dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/iced_vanilla_frappuccino"
                android:src="@drawable/iced_vanilla_frappuccino" />


        </GridLayout>


    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>