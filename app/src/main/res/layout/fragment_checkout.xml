<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"

    android:fontFamily="@font/playfair_display">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F0E6"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:gravity="center"
            android:paddingTop="50dp"
            android:text="@string/your_order"
            android:textColor="@color/black"
            android:textSize="34sp"
            android:textStyle="bold" >



        </TextView>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:gravity="center"
            android:paddingTop="5dp"
            android:text="@string/almost_there_Lets_make_it_yours"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="normal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >




            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/checkout_img_chocolate_truffle_mocha"
                android:layout_width="180dp"
                android:layout_height="195dp"
                android:background="@drawable/chocolate_truffle_mocha"
                android:elevation="10dp"
                android:gravity="center"
                android:layout_marginTop="22dp"
                android:textSize="34sp"
                android:textStyle=""
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <View
                android:id="@+id/checkout_card_background"
                android:layout_width="204dp"
                android:layout_height="195dp"
                android:layout_marginTop="22dp"
                android:background="#FAF7F2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/checkout_chocolate_truffle_mocha"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:id="@+id/checkout_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-204dp"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/playfair_display"
                android:gravity="start|center_vertical"
                android:paddingLeft="20dp"
                android:paddingTop="22dp"
                android:paddingRight="20dp"
                android:text="@string/chocolate_truffle_mocha"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/checkout_img_chocolate_truffle_mocha" />

            <TextView
                android:id="@+id/checkout_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-204dp"
                android:layout_marginTop="85dp"
                android:fontFamily="@font/playfair_display"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:paddingBottom="15dp"
                android:paddingEnd="2dp"
                android:text="@string/Rich_chocolate_velvety_mocha_pure_indulgence."
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="normal"

             />




        </LinearLayout>

        <TextView
            android:id="@+id/size_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:paddingTop="30dp"
            android:text="@string/Size"
            android:textStyle="bold"

            />
        
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            
            <Button
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                />




        </HorizontalScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>