<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fontFamily="@font/playfair_display">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:backgroundTint="#F8F6F0"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/add_to_order_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:gravity="center"
            android:paddingTop="20dp"
            android:text="@string/your_order"
            android:textColor="@color/black"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:gravity="center"
            android:paddingTop="5dp"
            android:text="@string/almost_there_Lets_make_it_yours"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="normal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/checkout_img_chocolate_truffle_mocha"
                android:layout_width="180dp"
                android:layout_height="195dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/chocolate_truffle_mocha"
                android:elevation="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:textSize="34sp"
                android:textStyle=""
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <View
                android:id="@+id/checkout_card_background"
                android:layout_width="204dp"
                android:layout_height="195dp"
                android:layout_marginTop="22dp"
                android:background="#FAF7F2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/checkout_chocolate_truffle_mocha"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/checkout_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-204dp"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/playfair_display"
                android:gravity="start|center_vertical"
                android:paddingLeft="20dp"
                android:paddingTop="22dp"
                android:paddingRight="20dp"
                android:text="@string/chocolate_truffle_mocha"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/checkout_img_chocolate_truffle_mocha"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/checkout_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-204dp"
                android:layout_marginTop="85dp"
                android:fontFamily="@font/playfair_display"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="2dp"
                android:paddingBottom="15dp"
                android:text="@string/Rich_chocolate_velvety_mocha_pure_indulgence."
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="normal" />

        </LinearLayout>

        <TextView
            android:id="@+id/size_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:paddingTop="15dp"
            android:paddingStart="20dp"
            android:text="@string/Size"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <Button
                android:id="@+id/small_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#F7E7CE"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/Small"
                android:textColor="#244A3A"
                android:textSize="18sp"

                app:layout_constraintEnd_toStartOf="@+id/med_button"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
               />

            <Button
                android:id="@+id/med_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:backgroundTint="#244A3A"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/Medium"
                android:textColor="#FFFFFF"
                android:textSize="18sp"

                app:layout_constraintEnd_toStartOf="@+id/large_button"
                app:layout_constraintStart_toEndOf="@+id/small_button"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/large_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#F7E7CE"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/Large"
                android:textColor="#244A3A"
                android:textSize="18sp"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/med_button"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>

        <TextView
            android:id="@+id/ice_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:paddingTop="15dp"
            android:text="@string/Ice_level"
            android:textColor="@color/black"
            android:paddingStart="20dp"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <Button
                android:id="@+id/zero_ice_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#F7E7CE"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/No_ice"
                android:textColor="#244A3A"
                android:textSize="18sp"

                app:layout_constraintEnd_toStartOf="@+id/light_ice_button"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/light_ice_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#F7E7CE"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/Light"
                android:textColor="#244A3A"
                android:textSize="18sp"

                app:layout_constraintEnd_toStartOf="@+id/zero_ice_button"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/reg_ice_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/reg_ice_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#244A3A"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/Regular"
                android:textColor="#FFFFFF"
                android:textSize="18sp"

                app:layout_constraintEnd_toStartOf="@+id/extra_ice_button"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/extra_ice_button"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#F7E7CE"
                android:maxWidth="320dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/Extra"
                android:textColor="#244A3A"
                android:textSize="18sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/add_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/playfair_display"
            android:paddingTop="15dp"
            android:text="@string/Add_ons"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingStart="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Extra Shot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/extra_shot_checkbox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/extra_shot"
                    android:textSize="18sp"
                    android:textColor="#244A3A"
                    android:buttonTint="#244A3A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_on_price"
                    android:textSize="18sp"
                    android:textColor="#244A3A" />

            </LinearLayout>

            <!-- Whipped Cream -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/whipped_cream_checkbox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/whipped_cream"
                    android:textSize="18sp"
                    android:textColor="#244A3A"
                    android:buttonTint="#244A3A"
                    android:checked="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_on_price"
                    android:textSize="18sp"
                    android:textColor="#244A3A" />

            </LinearLayout>

            <!-- Caramel Drizzle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/caramel_drizzle_checkbox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/caramel_drizzle"
                    android:textSize="18sp"
                    android:textColor="#244A3A"
                    android:buttonTint="#244A3A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_on_price"
                    android:textSize="18sp"
                    android:textColor="#244A3A" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#D6D0C6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/total_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total"
                android:fontFamily="@font/playfair_display"
                android:textColor="#244A3A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/total_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/checkout_total_price"
                android:textColor="#244A3A"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/add_to_order_button"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:layout_marginBottom="30dp"
        android:backgroundTint="#244A3A"
        android:text="@string/add_to_order"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="@drawable/bottom_green_controls"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/img_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="70dp"
            android:layout_marginEnd="70dp"
            android:text="@string/home_icon"
            android:textColor="@android:color/white"
            app:drawableTopCompat="@drawable/baseline_home_24" />

        <TextView
            android:id="@+id/img_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="70dp"
            android:layout_marginEnd="70dp"
            android:text="@string/order_icon"
            android:textColor="@android:color/white"
            app:drawableTopCompat="@drawable/ic_coffee_cup" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

